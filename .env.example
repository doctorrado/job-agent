# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never put real secrets in .env.example.

# Used from Phase 3 onward for LLM-powered job analysis / resume tailoring.
ANTHROPIC_API_KEY=

# Free credentials from https://developer.adzuna.com/ — used by the Adzuna
# job source in Phase 2. Remotive needs no key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Where your profile lives (see config/profile.example.yaml, coming in Step 5)
PROFILE_PATH=config/profile.yaml

# DEBUG, INFO, WARNING, or ERROR
LOG_LEVEL=INFO
